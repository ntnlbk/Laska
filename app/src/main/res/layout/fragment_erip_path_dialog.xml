<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_qr"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvEripTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text="Путь в дереве ЕРИП"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnClose"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnClose" />

    <!-- Close Button -->
    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_dark"
        android:padding="12dp"
        android:src="@drawable/close_btn_ic"
        app:backgroundTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ERIP Path List -->
    <LinearLayout
        android:id="@+id/containerEripPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/btnClose">

        <!-- Step 1 -->
        <TextView
            style="@style/EripPathItemStyle"
            android:text="•  Платежи" />

        <!-- Step 2 -->
        <TextView
            style="@style/EripPathItemStyle"
            android:text="•  Банковские финансовые услуги" />

        <!-- Step 3 -->
        <TextView
            style="@style/EripPathItemStyle"
            android:text="•  Банки, НКФО" />

        <!-- Step 4 -->
        <TextView
            style="@style/EripPathItemStyle"
            android:text="•  Беларусбанк" />

        <!-- Step 5 -->
        <TextView
            style="@style/EripPathItemStyle"
            android:text="•  Пополнение счета" />

        <!-- Step 6 (Account IBAN) -->
        <TextView
            android:id="@+id/tvEripAccount"
            style="@style/EripPathItemStyle"
            android:text="•  BY94AKBB30340019293080070000"/>

    </LinearLayout>

    <!-- Copy Account Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyAccount"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Скопировать счёт"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:backgroundTint="#3A3A3C"
        app:cornerRadius="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerEripPath"
        app:rippleColor="#33FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>