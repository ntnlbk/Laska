<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1B1B1B">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:visibility="invisible"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1B1B1B"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <LinearLayout
                android:id="@+id/btnBack"
                android:layout_width="100dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="17dp"
                    android:src="@drawable/back_btn_light_ic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:paddingBottom="3dp"
                    android:text="@string/back"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivCourseImage"
                android:layout_width="match_parent"
                android:layout_height="228dp"
                android:layout_marginTop="28dp"
                android:scaleType="centerCrop"
                tools:src="@drawable/home_fragment_courses_section_test_img"
                app:shapeAppearanceOverlay="@style/HomeFragmentCourseImageRounded" />


            <TextView
                android:layout_width="wrap_content"
                android:id="@+id/tvCourseTitle"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Course title" />

            <TextView
                android:id="@+id/informationTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0"
                android:lineSpacingExtra="4dp"
                android:maxLines="2"
                tools:text="Short description short description hort description short description short ...\n\nShort description short description hort description short description short .. Short description short description hort description short description short .. Short description short description hort description short description short .."
                android:textColor="#989898"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/detailedInformationBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0"
                android:lineSpacingExtra="4dp"
                tools:visibility="visible"
                android:visibility="invisible"
                android:text="Подробнее о курсе"
                android:textColor="#ECDDAC"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAuthors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_author" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartCourse"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:visibility="invisible"
                tools:visibility="visible"
                tools:text="Начать курс"
                android:text="Начать курс"
                android:textAllCaps="false"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                app:backgroundTint="#ECE0B2"
                app:cornerRadius="24dp" />

            <TextView
                android:id="@+id/tvEpisodesCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:fontFamily="@font/inter"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="26 sessions" />

            <LinearLayout
                android:id="@+id/containerEpisodes"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="36dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
