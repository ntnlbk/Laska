<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:clipToPadding="false"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="600dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/btnToMain"
                android:orientation="vertical"
                android:background="@drawable/home_fragment_first_gradient">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="40dp"
                    android:fontFamily="@font/soyuz_grotesk_bold"
                    android:letterSpacing="-0.05"
                    android:text="@string/splash_screen_main_text"
                    android:textColor="@android:color/white"
                    android:textSize="40sp" />

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="495dp"
                    app:use_controller="false"
                    app:surface_type="texture_view"
                    app:resize_mode="zoom"
                    app:shutter_background_color="@android:color/transparent">

                </androidx.media3.ui.PlayerView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="24dp"
                    android:layout_marginBottom="40dp"
                    >

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginVertical="8dp"
                        android:layout_weight="1">
                        <TextView
                            android:id="@+id/date_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            tools:text="Cуббота, 24 февраля"
                            android:text="Cуббота, 24 февраля"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/bible_ref_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter"
                            tools:text="Matthew 21:21–35"
                            android:text="Matthew 21:21–35"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"/>

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/play_btn"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_play_button"
                        android:padding="23dp"
                        android:src="@drawable/ic_play"/>
                </LinearLayout>

            </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/btnToCourse"
            android:orientation="vertical"
            android:background="#1B1B1B"
            android:paddingTop="36dp"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                tools:text="Новинка Laska"
                android:text="Новинка Laska"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="228dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_marginTop="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/home_fragment_courses_section_test_img"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/HomeFragmentCourseImageRounded"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="26 sessions"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="16dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/inter"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:background="@drawable/bg_sessions_count_tv"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/inter"
                tools:text="Course title"
                android:text="Course title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="4dp"

                android:letterSpacing="0"
                android:text="Short description short description hort description short description short ..."
                android:textColor="#989898"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/btnConfirm" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAuthors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="36dp"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_author" />

        </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>