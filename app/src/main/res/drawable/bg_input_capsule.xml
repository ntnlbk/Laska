<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Error State (Red border) -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A" />
            <stroke android:width="1.5dp" android:color="#FF4D4D" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <!-- Focused State (White border) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <!-- Default / Unfocused State (Gray border) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A" />
            <stroke android:width="1.5dp" android:color="#3A3A3C" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>